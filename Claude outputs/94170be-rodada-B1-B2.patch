+/// Service types offered by a DSP (Standard 9h, Nursery L1, Sameday, ...).
+///
+/// Replaces the fixed `RouteType` enum as the per-DSP registry. The enum is
+/// still what the payment tables store; repointing those columns is a data
+/// migration of its own and has not been done yet, so for now this table is
+/// the editable catalogue and `code` is the bridge back to the enum value.
+model ServiceType {
+  id             String   @id @default(uuid())
+  organizationId String
+  /// Stable key. Matches a RouteType enum value for the rows created by the backfill.
+  code           String
+  /// Editable label shown in the screens
+  name           String
+  /// Nominal paid hours, when the type has them
+  hours          Float?
+  isActive       Boolean  @default(true)
+  sortOrder      Int      @default(0)
+  createdAt      DateTime @default(now())
+  updatedAt      DateTime @updatedAt
+
+  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
+
+  @@unique([organizationId, code])
+  @@index([organizationId])
+  @@index([organizationId, isActive])
+  @@map("service_type")
+}
+
+/// Audit trail of things that happened inside a DSP.
+///
+/// Before this table the Audit Logs screen could only show sign-ins
+/// (login_attempt) and route price changes (payment_history), so anything else
+/// a user did left no trace. `security_events` was not usable for this: it has
+/// no organizationId, so it cannot be scoped to one DSP.
+///
+/// Rows are written, never updated or deleted — that is the point of a trail.
+model AuditLog {
+  id             String   @id @default(uuid())
+  organizationId String
+  /// Machine key, e.g. CANDIDATE_CONVERTED_TO_DRIVER
+  action         String
+  /// Model the action touched, e.g. "Driver"
+  entityType     String
+  entityId       String?
+  /// Who did it. Null for actions taken by the system itself.
+  actorUserId    String?
+  /// One sentence, shown as-is in the Audit Logs screen
+  summary        String
+  /// Anything structured worth keeping (ids, before/after, reason)
+  metadata       Json?
+  ipAddress      String?
+  userAgent      String?
+  occurredAt     DateTime @default(now())
+
+  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
+  actor        User?        @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
+
+  @@index([organizationId, occurredAt])
+  @@index([organizationId, action])
+  @@index([entityType, entityId])
+  @@map("audit_log")
+}
+
 /// Domains a DSP uses to access DSPHub (e.g. app.mydsp.co.uk).
 /// Requests are routed to an organization by the host they arrive on.
 model OrganizationDomain {
@@ -320,6 +386,8 @@ model Driver {
   homeDepotId         String?
   homeDepot           Depot?           @relation("DriverHomeDepot", fields: [homeDepotId], references: [id])
