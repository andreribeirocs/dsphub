  contato_inicial?: boolean;

  @IsOptional()
  @IsString()
  mini_entrevista_resultado?: string;

  @IsOptional()
  @IsString()
  teste_treinamento_resultado?: string;
}

export class UpdateCandidateDto {
  // ... existing fields ...

