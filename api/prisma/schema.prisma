generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth Core Tables
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Our custom fields
  role        UserRole   @default(DRIVER)
  status      UserStatus @default(ACTIVE)
  phoneNumber String?
  lastLogin   DateTime?
  avatar      String?

  // Better Auth relations
  sessions Session[]
  accounts Account[]
  members  Member[]

  // Our custom relations
  candidate             Candidate?
  driverProfile         Driver?
  processedPayments     DriverPayment[]
  loginAttempts         LoginAttempt[]
  paymentHistoryChanges PaymentHistory[]
  routePriceUpdates     RoutePrice[]
  suspiciousLogins      SuspiciousLogin[]
  sentInvoices          DriverInvoice[]

  @@index([role])
  @@index([status])
  @@index([lastLogin])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth specific
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  // Campos exigidos pelo better-auth 1.3.x (faltavam no schema antigo,
  // gerado por uma versao anterior da lib). Sem eles o login quebra.
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

// Better Auth Organization Tables
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  // Campo exigido pelo better-auth 1.3.x (plugin organization).
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Our custom fields for company branding
  address            String?
  city               String?
  postcode           String?
  country            String? @default("United Kingdom")
  phone              String?
  email              String?
  website            String?
  taxId              String?
  registrationNumber String?
  vatNumber          String? // VAT Number for invoices
  companyRegNumber   String? // Company Registration Number
  logoBase64         String? @db.Text
  bankName           String?
  bankAccountNumber  String?
  bankSortCode       String?
  iban               String?
  swiftCode          String?
  termsAndConditions String? @db.Text
  footerText         String?
  invoicePrefix      String? @default("INV") // Invoice number prefix
  invoiceFooter      String? @db.Text // Custom footer for invoices
  depots             Json? // Array of depot locations {name, address}
  isActive           Boolean @default(true)

  // Relations
  members     Member[]
  invitations Invitation[]

  // Our custom relations
  drivers            Driver[]
  candidates         Candidate[]
  driverPayments     DriverPayment[]
  invoices           DriverInvoice[]
  vans               Van[]
  contracts          Contract[]
  parts              Part[]
  maintenanceRecords MaintenanceRecord[]
  routePrices        RoutePrice[]

  @@index([slug])
  @@index([isActive])
  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
  @@map("invitation")
}

model RoutePrice {
  id             String           @id @default(uuid())
  organizationId String
  routeType      RouteType
  dailyRate      Decimal          @db.Decimal(8, 2)
  lastUpdated    DateTime         @default(now())
  updatedBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  priceHistory   PaymentHistory[]
  updatedByUser  User             @relation(fields: [updatedBy], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, routeType])
  @@index([organizationId])
  @@index([routeType])
  @@index([lastUpdated])
  @@index([updatedBy])
  @@map("route_prices")
}

model PaymentHistory {
  id            String     @id @default(uuid())
  routePriceId  String
  routeType     RouteType
  oldRate       Decimal?   @db.Decimal(8, 2)
  newRate       Decimal    @db.Decimal(8, 2)
  changeReason  String?
  changedBy     String
  changeDate    DateTime   @default(now())
  changedByUser User       @relation(fields: [changedBy], references: [id])
  routePrice    RoutePrice @relation(fields: [routePriceId], references: [id], onDelete: Cascade)

  @@index([routePriceId])
  @@index([routeType])
  @@index([changeDate])
  @@index([changedBy])
  @@map("payment_history")
}

model Driver {
  id                  String           @id @default(uuid())
  organizationId      String
  userId              String           @unique
  contractType        String?
  licenseNumber       String?
  licenseExpiry       DateTime
  insuranceNumber     String?
  address             String
  documents           Json?
  onboardingComplete  Boolean          @default(false)
  backgroundCheckDone Boolean          @default(false)
  classroomComplete   Boolean          @default(false)
  rideAlongDate       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  age                 Int
  citizenship         String
  completionRate      Float            @default(0)
  dbsStatus           String           @default("PENDING")
  depot               String
  email               String
  hasEndorsements     Boolean          @default(false)
  joinDate            DateTime
  lastCheck           DateTime
  licenseStatus       String           @default("PENDING")
  medicalStatus       String           @default("PENDING")
  name                String
  nextCheck           DateTime
  passportExpiry      DateTime
  passportStatus      String           @default("PENDING")
  phone               String
  points              Int              @default(0)
  rating              Float            @default(0)
  rtwExpiry           DateTime
  rtwStatus           String           @default("PENDING")
  status              String           @default("PENDING")
  totalTrips          Int              @default(0)
  transporterId       String
  user                User             @relation(fields: [userId], references: [id])
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentRecords      DriverPayment[]
  schedules           DriverSchedule[]
  invoices            DriverInvoice[]

  @@unique([organizationId, transporterId])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([status])
  @@index([depot])
  @@index([email])
  @@index([phone])
  @@index([transporterId])
  @@index([passportExpiry])
  @@index([licenseExpiry])
  @@index([rtwExpiry])
  @@index([nextCheck])
  @@index([joinDate])
  @@index([createdAt])
  @@index([status, depot])
  @@index([depot, status])
}

model DriverPayment {
  id                  String        @id @default(uuid())
  organizationId      String
  driverId            String
  workDate            DateTime      @db.Date
  routeType           RouteType
  dailyRate           Decimal       @db.Decimal(8, 2)
  hoursWorked         Decimal?      @db.Decimal(4, 2)
  totalPaid           Decimal       @db.Decimal(8, 2)
  isPaid              Boolean       @default(false)
  paidDate            DateTime?
  paidBy              String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deductionAmount     Decimal?      @db.Decimal(8, 2)
  extraAmount         Decimal?      @db.Decimal(8, 2)
  routeCode           String?
  sourceSheet         String?
  vanCharge           Decimal?      @db.Decimal(8, 2)
  isHelper            Boolean       @default(false)
  helperFor           String? // ID of the primary driver if this is a helper
  // New fields for 7 Days invoice system
  depot               String? // Which depot this payment is for
  weekNumber          Int? // Week number (e.g., 40)
  deliveryServiceType String? // DS type (DXW3, DRG3, etc.)
  mileage             Decimal?      @db.Decimal(6, 2) // Mileage for the route
  mileageCost         Decimal?      @db.Decimal(6, 2) // Mileage payment (£/mile)
  byod                Decimal?      @db.Decimal(6, 2) // BYOD payment
  incentive           Decimal?      @db.Decimal(6, 2) // Performance incentive
  awayDriver          Boolean       @default(false) // If this is an "AWAY DRIVER" payment
  awayDriverAmount    Decimal?      @db.Decimal(6, 2) // Away driver additional payment
  driver              Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  paidByUser          User?         @relation(fields: [paidBy], references: [id])
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems        InvoiceItem[]

  @@index([organizationId])
  @@index([driverId])
  @@index([workDate])
  @@index([routeType])
  @@index([isPaid])
  @@index([paidDate])
  @@index([paidBy])
  @@index([workDate, routeType])
  @@index([driverId, workDate])
  @@index([helperFor])
  @@index([isHelper])
  @@index([depot])
  @@index([weekNumber])
  @@map("driver_payments")
}

model Candidate {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  email          String? // Personal EMAIL
  phoneNumber    String // Phone
  status         CandidateStatus @default(LEAD)
  source         String?
  notes          String?

  // Personal Information
  dateOfBirth DateTime? // Date of Birth
  age         Int? // Age (calculated)
  citizenship String? // Citizenship

  // Address Information
  address    String?
  postalCode String? // Post Code

  // Document Information
  documentNumber  String? // Doc Number
  insuranceNumber String? // NIN (National Insurance Number)
  driverLicense   String? // DL Number

  // Expiry Dates
  passportVisaExpiry DateTime? // Passport Visa Expire
  rtwExpiry          DateTime? // RTW Expiry (Right to Work)
  licenceExpiry      DateTime? // Licence Expiry

  // DVLA Information
  points   Int?      @default(0) // points
  nextDVLA DateTime? // Next DVLA

  // System Fields
  lastCheck   DateTime? // Last Check on
  lastCheckOn DateTime? // last Check (duplicate for compatibility)

  // Agreement Information
  sla           String? // SLA
  account       String? // Account
  formCompleted Boolean? @default(false) // Form

  // Document Storage
  documents Json?

  // System Management
  userId        String?   @unique
  smsToken      String?
  tokenExpiry   DateTime?
  classroomDate DateTime?
  rideAlongDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user         User?        @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([phoneNumber])
  @@index([email])
  @@index([status])
  @@index([smsToken])
  @@index([tokenExpiry])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([classroomDate])
  @@index([rideAlongDate])
  @@index([dateOfBirth])
  @@index([citizenship])
  @@index([postalCode])
  @@index([documentNumber])
  @@index([passportVisaExpiry])
  @@index([rtwExpiry])
  @@index([licenceExpiry])
  @@index([nextDVLA])
  @@index([lastCheck])
}

model DriverSchedule {
  id        String         @id @default(uuid())
  driverId  String
  date      DateTime       @db.Date
  status    ScheduleStatus
  startTime String?
  endTime   String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  driver    Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, date])
  @@index([date])
  @@index([status])
  @@index([driverId, date])
  @@index([date, status])
  @@map("driver_schedules")
}

// Old session models removed - replaced by Better Auth Session model

model LoginAttempt {
  id          String   @id @default(uuid())
  userId      String?
  email       String
  success     Boolean
  ipAddress   String?
  userAgent   String?
  location    String?
  riskScore   Int      @default(0)
  riskFactors Json?
  attemptedAt DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([success])
  @@index([attemptedAt])
  @@index([ipAddress])
  @@index([email, success, attemptedAt])
  @@map("login_attempts")
}

model SuspiciousLogin {
  id             String    @id @default(uuid())
  userId         String
  activityType   String
  description    String
  riskScore      Int
  ipAddress      String?
  userAgent      String?
  location       String?
  sessionId      String?
  status         String    @default("pending")
  investigatedBy String?
  investigatedAt DateTime?
  notes          String?
  detectedAt     DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([detectedAt])
  @@index([riskScore])
  @@index([userId, status])
  @@map("suspicious_logins")
}

model SecurityEvent {
  id          String    @id @default(uuid())
  eventType   String
  severity    String
  description String
  userId      String?
  ipAddress   String?
  userAgent   String?
  endpoint    String?
  metadata    Json?
  status      String    @default("open")
  assignedTo  String?
  resolvedAt  DateTime?
  occurredAt  DateTime  @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([status])
  @@index([occurredAt])
  @@index([userId])
  @@map("security_events")
}

model Van {
  id                 String              @id @default(uuid())
  organizationId     String
  vanNumber          String
  registration       String
  make               String
  model              String
  year               Int?
  status             VanStatus           @default(AVAILABLE)
  condition          VanCondition        @default(GOOD)
  motExpiry          DateTime?
  motReminder        Boolean             @default(true)
  contractId         String?
  monthlyRental      Decimal?            @db.Decimal(8, 2)
  vin                String?
  engineNumber       String?
  fuelType           String?
  capacity           String?
  depot              String?
  assignedDriver     String?
  mileage            Int?                @default(0)
  lastService        DateTime?
  nextService        DateTime?
  comments           String?
  insuranceDetails   Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  maintenanceRecords MaintenanceRecord[]
  contract           Contract?           @relation(fields: [contractId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, vanNumber])
  @@unique([organizationId, registration])
  @@unique([organizationId, vin])
  @@index([organizationId])
  @@index([vanNumber])
  @@index([registration])
  @@index([status])
  @@index([condition])
  @@index([motExpiry])
  @@index([contractId])
  @@index([depot])
  @@index([status, condition])
  @@index([depot, status])
  @@map("vans")
}

model Contract {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  depot          String
  hireName       String
  rentalRate     Decimal        @db.Decimal(8, 2)
  status         ContractStatus @default(ACTIVE)
  hasInsurance   Boolean        @default(false)
  supplier       String?
  startDate      DateTime
  endDate        DateTime?
  contactEmail   String?
  contactPhone   String?
  description    String?
  terms          Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vans           Van[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([name])
  @@index([depot])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([depot, status])
  @@map("contracts")
}

model MaintenanceRecord {
  id              String              @id @default(uuid())
  organizationId  String
  vanId           String
  type            String
  description     String
  status          MaintenanceStatus   @default(SCHEDULED)
  priority        MaintenancePriority @default(MEDIUM)
  scheduledDate   DateTime
  completedDate   DateTime?
  estimatedCost   Decimal?            @db.Decimal(8, 2)
  actualCost      Decimal?            @db.Decimal(8, 2)
  workshop        String?
  workshopContact String?
  partsUsed       Json?
  laborHours      Decimal?            @db.Decimal(4, 2)
  notes           String?
  invoiceNumber   String?
  warrantyUntil   DateTime?
  reminderSent    Boolean             @default(false)
  isOverdue       Boolean             @default(false)
  assignedTo      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  van             Van                 @relation(fields: [vanId], references: [id], onDelete: Cascade)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vanId])
  @@index([status])
  @@index([priority])
  @@index([scheduledDate])
  @@index([type])
  @@index([vanId, status])
  @@index([scheduledDate, status])
  @@map("maintenance_records")
}

model Part {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  category       String?
  fordPrice      Decimal?     @db.Decimal(8, 2)
  mercedesPrice  Decimal?     @db.Decimal(8, 2)
  peugeotPrice   Decimal?     @db.Decimal(8, 2)
  partNumber     String?
  supplier       String?
  description    String?
  stockLevel     Int          @default(0)
  minStockLevel  Int          @default(0)
  maxStockLevel  Int          @default(100)
  weight         Decimal?     @db.Decimal(8, 3)
  dimensions     String?
  warrantyDays   Int?         @default(365)
  isActive       Boolean      @default(true)
  lastUpdated    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([name])
  @@index([category])
  @@index([partNumber])
  @@index([isActive])
  @@index([stockLevel])
  @@index([category, isActive])
  @@map("parts")
}

model DriverInvoice {
  id             String        @id @default(uuid())
  organizationId String
  driverId       String
  driver         Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber  String        @unique
  weekStartDate  DateTime      @db.Date
  weekEndDate    DateTime      @db.Date
  status         InvoiceStatus @default(DRAFT)
  totalAmount    Decimal       @db.Decimal(10, 2)
  currency       String        @default("GBP")
  notes          String?
  pdfUrl         String?
  sentAt         DateTime?
  sentBy         String?
  sentByUser     User?         @relation(fields: [sentBy], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          InvoiceItem[]

  @@index([organizationId])
  @@index([driverId])
  @@index([weekStartDate, weekEndDate])
  @@index([status])
  @@index([invoiceNumber])
  @@index([sentAt])
  @@map("driver_invoices")
}

model InvoiceItem {
  id          String         @id @default(uuid())
  invoiceId   String
  invoice     DriverInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     DriverPayment? @relation(fields: [paymentId], references: [id])
  date        DateTime       @db.Date
  description String
  routeType   RouteType
  routeCode   String?
  amount      Decimal        @db.Decimal(8, 2)

  @@index([invoiceId])
  @@index([paymentId])
  @@index([date])
  @@map("invoice_items")
}

enum UserRole {
  SUPER_ADMIN // Can manage all organizations (system-wide)
  OWNER // Organization owner (maps to Better Auth admin role)
  DIRECTOR // Company director
  MANAGER_FINANCIAL
  MANAGER_FLEET
  MANAGER_ONSITE
  MANAGER_RECRUITMENT
  DRIVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum RouteType {
  FULL_ROUTE
  HIDE_ALONG
  TRAINING_DAY
  SAME_DAY
  NURSERY_ROUTE
  EXTRAS
  ORDT_EXTRA_LARGE_CARGO_VAN
  STANDARD_PARCEL_MEDIUM_VAN
  NURSERY_ROUTE_LEVEL_1
  NURSERY_ROUTE_LEVEL_2
  NURSERY_ROUTE_LEVEL_3
  NURSERY_ROUTE_LEVEL_4
  STANDARD_PARCEL
  STANDARD_PARCEL_LOW_EMISSION_VEHICLE_LARGE
  STANDARD_PARCEL_WITH_HELPER
  STANDARD_PARCEL_RIDE_ALONG_IRONHIDE_MEDIUM_VAN
  STANDARD_PARCEL_RIDE_ALONG_MENTEE_IRONHIDE_MEDIUM_VAN
  OSM_RATE // On Site Manager
  OSM_COVER // On Site Manager Cover
  HELPER_FLEET // Helper + Fleet
  SWEEPER
  HELPER
  ROUTE_9H // Route 9 hours
  LEAD_DRIVER
  RESCUE_2 // Rescue 2
  RESCUE_6 // Rescue 6
}

enum CandidateStatus {
  LEAD
  SMS_SENT
  FORM_COMPLETED
  DOCUMENTS_UPLOADED
  BACKGROUND_CHECK
  APPROVED
  CLASSROOM_SCHEDULED
  CLASSROOM_COMPLETED
  RIDE_ALONG_SCHEDULED
  RIDE_ALONG_COMPLETED
  ACTIVE_DRIVER
  REJECTED
}

enum ScheduleStatus {
  FULL_ROUTE
  OFF
  HOLIDAY
  RIDE_ALONG
  TRAINING_DAY
  SAME_DAY
  NURSERY_ROUTE
}

enum VanStatus {
  BOOKED
  DELIVERED
  TBC
  AVAILABLE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum VanCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  NEEDS_ATTENTION
}

enum ContractStatus {
  ACTIVE
  REMOVED
  BROKEN_DOWN
  SUSPENDED
  EXPIRED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SENT
  CANCELLED
}
