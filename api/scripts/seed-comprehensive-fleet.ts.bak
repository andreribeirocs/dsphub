  console.log("✅ Comprehensive fleet data seeded successfully!");
  console.log(`📊 Created:`);
  console.log(`   - 1 main contract (Amazon)`);
  console.log(`   - ${createdVans.length} vans from spreadsheet`);
  console.log(`   - ${maintenanceRecords.length} maintenance records`);
  console.log(`   - 15 parts in inventory`);
  console.log(
    `   - ${createdVans.filter((v) => v.status === "BOOKED").length} vans currently booked`
  );
  console.log(
    `   - ${createdVans.filter((v) => v.status === "OUT_OF_SERVICE").length} vans out of service`
  );
  console.log(
    `   - ${createdVans.filter((v) => v.status === "TBC").length} vans TBC`
  );
}

async function main() {
  try {
    await seedComprehensiveFleet();
  } catch (error) {
    console.error("❌ Error seeding comprehensive fleet data:", error);
    process.exit(1);
  } finally {
    await prisma.$disconnect();
  }
}

main();
