      contractId: amazonContract.id,
      depot: "DP01",
      fuelType: "Diesel",
      paveDone: false,
      supplier: "Ayvans",
      hasInsurance: true,
      comments:
        "MOT FAILED, 6 halftones for repairs, loose panel passenger side, rear door open c",
    },
  ];

  // Create all vans
  console.log(`Creating ${vansData.length} vans...`);
  const createdVans: Van[] = [];

  for (const vanData of vansData) {
    const van = await prisma.van.create({
      data: {
        organizationId,
        vanNumber: vanData.vanNumber,
        registration: vanData.registration,
        make: vanData.make,
        model: vanData.model,
        year: vanData.year,
        status: vanData.status as VanStatus,
        condition: vanData.condition as VanCondition,
        motExpiry: vanData.motExpiry,
        monthlyRental: vanData.monthlyRental,
        contractId: vanData.contractId,
        depot: vanData.depot,
        assignedDriver: vanData.assignedDriver,
        fuelType: vanData.fuelType,
        capacity: vanData.capacity,
        comments: vanData.comments,
      },
    });
    createdVans.push(van);
  }

  // Create maintenance records for vans that need attention
  console.log("Creating maintenance records...");
  const maintenanceRecords: any[] = [];

  // MOT renewals for expired/expiring MOTs
  const expiredMotVans = createdVans.filter(
    (van) =>
      van.motExpiry &&
      van.motExpiry < new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  );
  for (const van of expiredMotVans) {
    maintenanceRecords.push({
      vanId: van.id,
      type: "MOT",
      description: "MOT renewal required",
      scheduledDate: van.motExpiry || new Date(),
      status: "SCHEDULED",
      priority: van.motExpiry && van.motExpiry < new Date() ? "URGENT" : "HIGH",
      estimatedCost: 150.0,
      workshop: "Authorized MOT Centre",
      notes: `MOT ${van.motExpiry && van.motExpiry < new Date() ? "expired" : "expiring soon"}`,
    });
  }

  // Specific maintenance for vans with issues
  const problematicVans = [
    {
      registration: "LD71UNF",
      issue: "INDICATOR BULB NEVER WORKS",
      cost: 50.0,
    },
    { registration: "KN70JDE", issue: "BRAKES ISSUES", cost: 300.0 },
    {
      registration: "KO21TXV",
      issue: "Front bumper brackets broken",
      cost: 200.0,
    },
    {
      registration: "KN74PCA",
      issue: "Skidding door damage, not closing properly",
      cost: 450.0,
    },
    {
      registration: "KN74PLM",
      issue: "Sharp edge to be fixed FRONT BUMPER",
      cost: 150.0,
    },
    {
      registration: "KN74FTY",
      issue: "Driver door not closing properly",
      cost: 250.0,
    },
    {
      registration: "LD71KFN",
      issue: "Mirror held by tape - needs replacement",
      cost: 75.0,
    },
    { registration: "KO21EGQ", issue: "BRAKES ISSUES", cost: 300.0 },
    { registration: "KY74VFL", issue: "Wipers not working", cost: 120.0 },
    { registration: "KO21DUA", issue: "DOOR AND WING FALLING", cost: 500.0 },
    { registration: "LD71OPE", issue: "Hanging wire repair", cost: 80.0 },
    {
      registration: "LC21WNZ",
      issue: "MOT FAILED - multiple repairs needed",
      cost: 600.0,
    },
  ];

  for (const problem of problematicVans) {
    const van = createdVans.find(
      (v) => v.registration === problem.registration
    );
    if (van) {
      maintenanceRecords.push({
        vanId: van.id,
        type: "Repair",
        description: problem.issue,
        scheduledDate: new Date(
          Date.now() + Math.random() * 14 * 24 * 60 * 60 * 1000
        ), // Random date within 2 weeks
        status: van.status === "OUT_OF_SERVICE" ? "IN_PROGRESS" : "SCHEDULED",
        priority:
          problem.cost > 400
            ? "URGENT"
            : problem.cost > 200
              ? "HIGH"
              : "MEDIUM",
        estimatedCost: problem.cost,
        workshop: "Fleet Maintenance Centre",
        notes: `Issue reported: ${problem.issue}`,
      });
    }
  }

  // Create all maintenance records
  for (const record of maintenanceRecords) {
    await prisma.maintenanceRecord.create({
      data: {
        organizationId,
        vanId: record.vanId,
        type: record.type,
        description: record.description,
        scheduledDate: record.scheduledDate,
        status: record.status as any,
        priority: record.priority as any,
        estimatedCost: record.estimatedCost,
        workshop: record.workshop,
        notes: record.notes,
      },
    });
  }

  // Create parts inventory with realistic stock levels
  await Promise.all([
    // Mirror parts
    prisma.part.create({
