# DSPHub API — modelo de variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# Para gerar segredos: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Banco
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/dsphub

# Autenticação
# better-auth lê BETTER_AUTH_SECRET automaticamente. Sem ele, usa um segredo padrão público.
BETTER_AUTH_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
BCRYPT_ROUNDS=12

# CORS (separado por vírgula)
CORS_ORIGIN=http://localhost:4200,http://localhost:3000

# Mensageria (WhatsApp/SMS) — nenhum provedor conectado ainda (ver src/messaging)
# RECRUITMENT_INVITE_TEMPLATE=registration_link

# Limites de upload (bytes)
MAX_FILE_SIZE=10485760
MAX_PDF_SIZE=25165824
MAX_IMAGE_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MEDIUM_MS=600000
RATE_LIMIT_MAX_REQUESTS_MEDIUM=500
RATE_LIMIT_WINDOW_LONG_MS=3600000
RATE_LIMIT_MAX_REQUESTS_LONG=1000
